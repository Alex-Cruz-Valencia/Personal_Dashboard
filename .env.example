# ─────────────────────────────────────────────────────────────────────────────
# Morning Dashboard — configuration
#
# Copy to `.env.local` and fill in what you want. With NOTHING set, the
# dashboard renders the reference design with frozen mock data (demo mode).
# Each phase below turns on independently.
# ─────────────────────────────────────────────────────────────────────────────

# ---- General ----------------------------------------------------------------
DASHBOARD_USER_NAME="Ellis"
DASHBOARD_TIMEZONE="America/Los_Angeles"
DASHBOARD_LATITUDE="37.7749"
DASHBOARD_LONGITUDE="-122.4194"
# Visible span of the day arc (whole local hours)
DASHBOARD_ARC_FROM="6"
DASHBOARD_ARC_TO="22"
# Base URL used to build the Google OAuth redirect (no trailing slash)
DASHBOARD_BASE_URL="http://localhost:3000"
# Force the frozen mock dataset even when integrations are configured
# DASHBOARD_FORCE_MOCK="true"

# ---- Phase 2: Weather (Open-Meteo, no key) ----------------------------------
# Goes live automatically once any integration below is set. To turn it on by
# itself, set this to "true". Set to "false" to always use the mock.
# DASHBOARD_WEATHER_ENABLED="true"

# ---- Phase 3: Todoist ------------------------------------------------------
# Get a token at: Todoist → Settings → Integrations → Developer → API token
# TODOIST_API_TOKEN=""
# TODOIST_FILTER="(today | overdue)"

# ---- Phase 4: Google Calendar + Gmail (OAuth2, read-only) ------------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
# (Web application). Add an authorized redirect URI of:
#   http://localhost:3000/api/auth/google/callback
# Enable the "Google Calendar API" and "Gmail API" for the project.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# GOOGLE_CALENDAR_ID="primary"
# GMAIL_QUERY="in:inbox is:unread -category:promotions -category:social newer_than:7d"
# Signs the token cookie — set to any long random string
# DASHBOARD_SESSION_SECRET=""

# ---- Phase 5: Anthropic daily summary --------------------------------------
# ANTHROPIC_API_KEY=""
# A small model is plenty for a one-liner and much cheaper:
# ANTHROPIC_MODEL="claude-haiku-4-5"
